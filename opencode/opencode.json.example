{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "qwen38-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen3.8-27B (local llama.cpp)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:LLAMA_API_KEY}"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8-27B Q4_K_M",
          "tools": true,
          "reasoning": true,
          "limit": {
            "context": 131072,
            "output": 24000
          }
        }
      }
    }
  }
}
